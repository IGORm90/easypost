APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=media
# AWS_ENDPOINT is what the php/horizon/scheduler containers use to reach
# MinIO over the Docker Compose network -- "minio" only resolves inside
# that network, never from a browser.
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Task 27 review finding 4 (Important): AWS_URL is what
# Storage::disk('media')->url() actually returns to API clients (see
# config/filesystems.php's `media` disk) -- left unset, it falls back to
# AWS_ENDPOINT above, so every MediaResource.url/thumbnail_url pointed
# at the compose-internal "http://minio:9000/...", unreachable from a
# browser outside the Docker network. Set to MinIO's *published* host
# port (docker-compose.yaml maps "9000:9000") so URLs returned to the
# frontend actually resolve. Production must point this at the real
# public S3/MinIO endpoint instead -- it is never the same value as
# AWS_ENDPOINT once the two networks (server-to-storage vs.
# browser-to-storage) diverge, which is always true outside this local
# Docker setup.
AWS_URL=http://localhost:9000/media

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_BASE_URL=

OAUTH_SPA_REDIRECT_URL=

# The SPA page that receives a provider's redirect when connecting a
# channel (Task 13). Defaults to OAUTH_SPA_REDIRECT_URL + /integrations/callback
# — see config/services.php.
INTEGRATIONS_REDIRECT_URL=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

SLACK_INTEGRATION_CLIENT_ID=
SLACK_INTEGRATION_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"
