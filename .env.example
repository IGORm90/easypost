APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
# MUST stay comfortably ABOVE the longest supervisor timeout in
# config/horizon.php (currently 90s, supervisor-publish). Laravel's rule:
# retry_after is when the queue considers a reserved job abandoned and hands
# it to another worker — if it is not strictly greater than the worker
# timeout, a slow publish is redelivered while it is still running, and the
# second worker can re-send segments the first one already put on the
# network. See docs/DEPLOYMENT.md, "Queue timeouts".
REDIS_QUEUE_RETRY_AFTER=300

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=media
# AWS_ENDPOINT is what the php/horizon/scheduler containers use to reach
# MinIO over the Docker Compose network -- "minio" only resolves inside
# that network, never from a browser.
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Task 27 review finding 4 (Important): AWS_URL is what
# Storage::disk('media')->url() actually returns to API clients (see
# config/filesystems.php's `media` disk) -- left unset, it falls back to
# AWS_ENDPOINT above, so every MediaResource.url/thumbnail_url pointed
# at the compose-internal "http://minio:9000/...", unreachable from a
# browser outside the Docker network. Set to MinIO's *published* host
# port (docker-compose.yaml maps "9000:9000") so URLs returned to the
# frontend actually resolve. Production must point this at the real
# public S3/MinIO endpoint instead -- it is never the same value as
# AWS_ENDPOINT once the two networks (server-to-storage vs.
# browser-to-storage) diverge, which is always true outside this local
# Docker setup.
AWS_URL=http://localhost:9000/media

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_BASE_URL=

OAUTH_SPA_REDIRECT_URL=

# The SPA page that receives a provider's redirect when connecting a
# channel (Task 13). Defaults to OAUTH_SPA_REDIRECT_URL + /integrations/callback
# — see config/services.php.
INTEGRATIONS_REDIRECT_URL=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

SLACK_INTEGRATION_CLIENT_ID=
SLACK_INTEGRATION_CLIENT_SECRET=

# Block 5's eight networks. All OAuth 2.0 client pairs; see README.md's
# "Obtaining credentials" section for how to register each app. Leaving a
# pair empty simply means that channel cannot be connected on this
# deployment -- nothing else breaks.
#
# TWITTER_* is X, and META_THREADS_* is Threads: the machine identifiers
# differ from the brand names on purpose (see config/services.php).
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Required, and rejected if generic: 'easypost/1.0 by /u/your-account'.
REDDIT_USER_AGENT=

FACEBOOK_PAGE_CLIENT_ID=
FACEBOOK_PAGE_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

INSTAGRAM_STANDALONE_CLIENT_ID=
INSTAGRAM_STANDALONE_CLIENT_SECRET=

META_THREADS_CLIENT_ID=
META_THREADS_CLIENT_SECRET=

# Ops (optional) -- this app's own operational alerts, unrelated to end
# users connecting Slack as a publishing channel above.
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Ops (optional) -- alternative transactional-mail drivers, if not using
# SMTP/Mailpit.
POSTMARK_API_KEY=
RESEND_API_KEY=

VITE_APP_NAME="${APP_NAME}"
