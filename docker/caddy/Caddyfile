# TLS terminator and the only thing that listens on the host (80/443).
# Caddy gets and renews the certificates itself (Let's Encrypt, HTTP-01), which
# is why it must be reachable on 80 as well as 443 and why caddy-data is a
# named volume: losing it means re-issuing, and Let's Encrypt rate-limits that.
#
# APP_HOST, MEDIA_HOST and LANDING_HOST come from the container environment
# (docker/compose.production.yaml). Plain HTTP is redirected to HTTPS
# automatically for every site below.
#
# A rehearsal on a machine with no public DNS cannot pass Let's Encrypt's
# challenge. It sets CADDY_GLOBAL_OPTIONS=local_certs in its .env, and Caddy
# then signs with its own local CA. Production leaves the variable empty. This
# keeps the rehearsed file and the deployed file one and the same.
{
	{$CADDY_GLOBAL_OPTIONS}
}

{$APP_HOST} {
	# The landing page owns `/` of the landing host. Here `/` is where OAuth
	# returns and where bookmarks point: open the app, which sends a signed-out
	# visitor on to /login by itself.
	@root path /
	redir @root /calendar 302

	# The same 108 MiB that nginx (client_max_body_size) and php.ini
	# (post_max_size) accept: a 100 MB file plus multipart framing. If Caddy's
	# ceiling were lower the user would get a bare 413 from the proxy before
	# Laravel's own validation ever answered. MiB, not MB: Caddy reads MB as
	# 10^6 bytes, which would be ~5 MB under nginx's and php's 108M.
	request_body {
		max_size 108MiB
	}

	encode zstd gzip

	# nginx sits on the Compose network only; this is the sole way in.
	reverse_proxy nginx:80
}

{$MEDIA_HOST} {
	# Uploaded media is public by URL (docs/DEPLOYMENT.md), and that is ALL this
	# host serves: a read of a single object of the `media` bucket. A path
	# ending in `/` is a bucket or prefix listing, which MinIO's anonymous
	# policy (docker/minio/media-policy.json) already refuses; it is excluded
	# here too, so the refusal does not depend on a policy file staying intact.
	# The MinIO console (9001), the admin API and every write method never get
	# past this matcher.
	@object {
		method GET HEAD
		path_regexp ^/media/.+[^/]$
	}

	handle @object {
		reverse_proxy minio:9000
	}

	handle {
		respond "Not found" 404
	}
}

# The landing page is a route of the same SPA, so nginx would serve it on any host
# that reaches it. This host answers ONLY what the page itself needs and sends
# every other path to the app host, because the session cookie and Sanctum's
# stateful domain belong to the app host alone: a login form served from here
# would load and then fail on every API call.
{$LANDING_HOST} {
	encode zstd gzip

	@page {
		path / /build/* /favicon.ico /robots.txt
	}

	handle @page {
		reverse_proxy nginx:80
	}

	# The page asks /api/auth/me who is signed in. A redirect to another origin
	# would be a CORS error in every visitor's console; a plain 401 is that
	# endpoint's own "not signed in" answer and is handled as such.
	handle /api/* {
		respond "" 401
	}

	handle {
		redir https://{$APP_HOST}{uri} 308
	}
}

www.{$LANDING_HOST} {
	redir https://{$LANDING_HOST}{uri} 308
}
