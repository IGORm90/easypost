# Template for the server's /opt/easypost/.env (DEPLOY.md, stage 4). Copy it,
# fill the empty values, `chmod 600`, keep it out of Git and out of every image.
#
# Compose reads this file for interpolation (--env-file) AND the app containers
# read it as their environment (env_file: ../.env), so one file feeds both.
# Values are literals: do not use ${VAR} inside it, env_file does not expand it.
#
# Passwords: `openssl rand -hex 32`. Hex, not base64: `/`, `+` and `=` break the
# URL that scripts/backup.sh builds for MinIO.

# --- Images (EASYPOST_TAG is NOT here: scripts/lib.sh exports it from .current-tag)
EASYPOST_IMAGE=ghcr.io/OWNER/easypost
EASYPOST_WEB_IMAGE=ghcr.io/OWNER/easypost-web

# --- Hosts
APP_HOST=app.example.com
MEDIA_HOST=media.example.com

# --- Application
APP_NAME=EasyPost
APP_ENV=production
APP_DEBUG=false
# Generate ONCE on the first install (`php artisan key:generate --show` in the
# image) and back it up off the server: losing it makes every stored channel
# token permanently undecryptable. Never regenerate on an install with channels.
APP_KEY=
APP_URL=https://app.example.com

LOG_CHANNEL=stack
LOG_STACK=app,errors,viewer
LOG_LEVEL=info

# --- Launch closed: the first account is made by the operator, then
# `php artisan user:superadmin <email>`. NOTE an Invite cannot be accepted
# without an existing account, so this also stops new people joining.
REGISTRATION_ENABLED=false

# --- Behind Caddy: trust exactly the address docker/compose.production.yaml
# gives it, nothing wider and never `*`. ProductionArtifactsTest keeps the two
# in step.
TRUSTED_PROXIES=172.30.77.2

# --- Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=easypost
DB_USERNAME=easypost
DB_PASSWORD=

# --- Redis (session, cache and queue). REDIS_QUEUE_RETRY_AFTER must stay above
# the longest Horizon supervisor timeout (90s) or a slow publish is handed to a
# second worker while the first is still sending, and goes out twice.
REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=app.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_QUEUE_RETRY_AFTER=300

PULSE_SERVER_NAME=easypost

# --- Media (MinIO in this stack). The AWS_* pair repeats the MINIO_ROOT_* pair.
MINIO_ROOT_USER=easypost
MINIO_ROOT_PASSWORD=
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=easypost
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=https://media.example.com/media

# --- Mail (Resend)
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- OAuth return URLs
OAUTH_SPA_REDIRECT_URL=https://app.example.com
INTEGRATIONS_REDIRECT_URL=https://app.example.com/integrations/callback
