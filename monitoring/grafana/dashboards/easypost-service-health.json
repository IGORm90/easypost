{
  "annotations": { "list": [] },
  "description": "Operational view of EasyPost structured logs. An empty error-rate panel can mean either healthy traffic or no traffic; use the Log pipeline dead alert to tell those cases apart.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Counts every emitted structured error record, including failed jobs. Production mirrors application errors to its general and dedicated error outputs; the error-spike rule compares this rate with the same route's historical baseline.",
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum(rate({app=\"easypost\", level=\"error\"}[5m]))", "refId": "A" }],
      "title": "Error rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "{app=\"easypost\", level=\"error\"} | json | line_format `{{.message}} — {{.context_exception}}`", "refId": "A" }],
      "title": "Error log",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [{ "expr": "{app=\"easypost\", level=\"info\"} | json organization_id=\"extra.organization_id\" | organization_id=~\"$org\"", "refId": "A" }],
      "title": "Info log",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        { "expr": "sum(rate({app=\"easypost\", service=\"nginx\"} | json | status =~ \"2..\" [5m]))", "legendFormat": "2xx", "refId": "A" },
        { "expr": "sum(rate({app=\"easypost\", service=\"nginx\"} | json | status =~ \"4..\" [5m]))", "legendFormat": "4xx", "refId": "B" },
        { "expr": "sum(rate({app=\"easypost\", service=\"nginx\"} | json | status =~ \"5..\" [5m]))", "legendFormat": "5xx", "refId": "C" }
      ],
      "title": "HTTP RPS by status class",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "targets": [{ "expr": "quantile_over_time(0.95, {app=\"easypost\", service=\"nginx\"} | json | unwrap duration [5m])", "refId": "A" }],
      "title": "HTTP latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "targets": [{ "expr": "sum by (queue) (rate({app=\"easypost\", service=\"horizon\", channel=\"jobs\"} | json message=\"message\", queue=\"context.queue\" | message=\"job.processed\" | label_format queue=`{{.queue}}` [1m]))", "refId": "A" }],
      "title": "Job RPS by queue",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 7,
      "targets": [{ "expr": "sum(rate({app=\"easypost\", service=\"horizon\", channel=\"jobs\"} | json message=\"message\" | message=\"job.failed\" [1m]))", "refId": "A" }],
      "title": "Job failure rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 8,
      "targets": [{ "expr": "quantile_over_time(0.95, {app=\"easypost\", service=\"horizon\", channel=\"jobs\"} | json message=\"message\", lateness_ms=\"context.lateness_ms\" | message=\"publish.attempt\" | unwrap lateness_ms [15m])", "refId": "A" }],
      "title": "Publish lateness p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 9,
      "targets": [{ "expr": "sum by (failure_kind) (rate({app=\"easypost\", service=\"horizon\", channel=\"jobs\"} | json message=\"message\", failure_kind=\"context.failure_kind\" | message=\"publish.attempt\" | failure_kind=~\".+\" | label_format failure_kind=`{{.failure_kind}}` [15m]))", "refId": "A" }],
      "title": "Publish failures by kind",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["easypost", "logs"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": ".*", "value": ".*" },
        "hide": 0,
        "label": "Organization ID (regex)",
        "name": "org",
        "options": [],
        "query": ".*",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "EasyPost — Service Health",
  "uid": "easypost-service-health",
  "version": 1,
  "weekStart": ""
}
